# Local MCP defaults to stdio. This file contains no secrets.
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8000
USE_LAKEHOUSE=false
NCBI_EMAIL=you@example.gov
NCBI_API_KEY=
# Optional approved Databricks host(s), when serving HTTP behind workspace OAuth:
MCP_ALLOWED_HOSTS=
# Required for any non-loopback HTTP binding (cannot be disabled remotely).
# Configure an existing OAuth issuer that issues RS256 access tokens for this resource.
# Public verification key only; use literal \n or a multiline value. NEVER a private key.
MCP_AUTH_REQUIRED=false
MCP_AUTH_PUBLIC_KEY=
MCP_AUTH_ISSUER=
MCP_AUTH_AUDIENCE=
# Required token scopes: mcp:connect plus tool:<exact_tool_name> for each allowed tool.
# Gateway authentication alone does not satisfy this additional application check.
# Evaluation uses existing CLI authentication, never a token committed to this file.
DATABRICKS_HOST=
DATABRICKS_CONFIG_PROFILE=
DATABRICKS_CLI_PATH=databricks
AGENT_MODEL=
JUDGE_MODEL=
MLFLOW_EXPERIMENT_ID=
MCP_EVAL_ENDPOINT=http://127.0.0.1:8000/mcp
# Required only if attaching a token to a remote MCP endpoint:
DATABRICKS_MCP_ENDPOINT=
